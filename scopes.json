  "semanticTokenTypes": {
    "namespace":                { "description": "Namespace declarations and references" },
    "type":                     { "description": "Type references" },
    "type.declaration":         { "description": "Type declarations (definition site)" },
    "class":                    { "description": "Class references" },
    "class.declaration":        { "description": "Class declarations" },
    "enum":                     { "description": "Enum type references" },
    "interface":                { "description": "Interface type references" },
    "struct":                   { "description": "Struct type references" },
    "typeParameter":            { "description": "Generic type parameters (<T>, etc.)" },
    "parameter":                { "description": "Function/method parameters" },
    "parameter.output":         { "description": "Output/inout parameters" },
    "variable":                 { "description": "Local variable references" },
    "variable.readonly":        { "description": "Read-only / const variables" },
    "variable.static":          { "description": "Static / global variables" },
    "variable.static.readonly": { "description": "Static read-only / module constants" },
    "property":                 { "description": "Object/struct property references" },
    "property.readonly":        { "description": "Read-only properties" },
    "property.static":          { "description": "Static properties" },
    "enumMember":               { "description": "Enum member references" },
    "event":                    { "description": "Event references" },
    "function":                 { "description": "Function references" },
    "function.declaration":     { "description": "Function declarations (definition site)" },
    "method":                   { "description": "Method references" },
    "method.declaration":       { "description": "Method declarations" },
    "macro":                    { "description": "Macro references" },
    "macro.readonly":           { "description": "Read-only macro references" },
    "decorator":                { "description": "Decorators / annotations" },
    "keyword":                  { "description": "Keywords (semantic overlay)" },
    "modifier":                 { "description": "Modifier keywords (pub, mut, async, etc.)" },
    "comment":                  { "description": "Comments (semantic overlay)" },
    "string":                   { "description": "Strings (semantic overlay)" },
    "number":                   { "description": "Numbers (semantic overlay)" },
    "regexp":                   { "description": "Regular expressions (semantic overlay)" },
    "operator":                 { "description": "Operators (semantic overlay)" },
    "newOperator":              { "description": "new operator specifically" },
    "stringLiteral":            { "description": "String literals (C++ semantic)" },
    "customLiteral":            { "description": "Custom/user-defined literals (C++)" },
    "numberLiteral":            { "description": "Number literals (C++ semantic)" }
  },

  "uiRoles": {
    "background":          { "key": "editor.background",                              "description": "Main editor background" },
    "foreground":          { "key": "editor.foreground",                              "description": "Default editor text color" },
    "cursor":              { "key": "editorCursor.foreground",                        "description": "Cursor/caret color" },
    "lineHighlight":       { "key": "editor.lineHighlightBackground",                "description": "Current line highlight" },
    "selection":           { "key": "editor.selectionBackground",                     "description": "Text selection background" },
    "indentGuide":         { "key": "editorIndentGuide.background1",                  "description": "Indent guide lines" },
    "indentGuideActive":   { "key": "editorIndentGuide.activeBackground1",            "description": "Active indent guide lines" },
    "lineNumber":          { "key": "editorLineNumber.foreground",                    "description": "Line number color" },
    "lineNumberActive":    { "key": "editorLineNumber.activeForeground",              "description": "Active line number color" },
    "ruler":               { "key": "editorRuler.foreground",                         "description": "Editor ruler lines" },
    "bracketMatchBg":      { "key": "editorBracketMatch.background",                  "description": "Matching bracket background" },
    "bracketMatchBorder":  { "key": "editorBracketMatch.border",                      "description": "Matching bracket border" },
    "panel":               { "key": "activityBar.background",                         "description": "Activity bar / sidebar / status bar background" },
    "badge":               { "key": "activityBarBadge.background",                    "description": "Badge background (notification counts)" },
    "panelForeground":     { "key": "sideBarTitle.foreground",                        "description": "Sidebar title text color" },
    "tabActive":           { "key": "tab.activeBackground",                           "description": "Active tab background" },
    "tabInactive":         { "key": "tab.inactiveBackground",                         "description": "Inactive tab background" },
    "bracket1":            { "key": "editorBracketHighlight.foreground1",              "description": "Rainbow bracket color 1" },
    "bracket2":            { "key": "editorBracketHighlight.foreground2",              "description": "Rainbow bracket color 2" },
    "bracket3":            { "key": "editorBracketHighlight.foreground3",              "description": "Rainbow bracket color 3" },
    "bracket4":            { "key": "editorBracketHighlight.foreground4",              "description": "Rainbow bracket color 4" },
    "bracket5":            { "key": "editorBracketHighlight.foreground5",              "description": "Rainbow bracket color 5" },
    "bracket6":            { "key": "editorBracketHighlight.foreground6",              "description": "Rainbow bracket color 6" },
    "bracketBad":          { "key": "editorBracketHighlight.unexpectedBracket.foreground", "description": "Unexpected/unmatched bracket" }
  }
}
