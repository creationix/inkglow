      "scopes": [
        "punctuation.bracket",
        "keyword.operator.bracket",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ]
    },
    "pointer": {
      "description": "Pointer/dereference punctuation (* & ->)",
