      ]
    },
    "punctuation": {
      "description": "General punctuation — commas, semicolons, colons",
      "scopes": [
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.terminator",
        "punctuation.terminator.statement"
      ]
    },
    "invalid": {
      "description": "Invalid/illegal syntax",
      "scopes": [
        "invalid",
        "invalid.illegal"
      ]
    },
    "deprecated": {
      "description": "Deprecated code",
      "scopes": [
        "invalid.deprecated"
      ]
    },
    "support": {
      "description": "Built-in/library support references (catch-all)",
      "scopes": [
        "support",
        "support.constant",
        "support.other"
      ]
    },
    "meta.embedded": {
      "description": "Embedded code in templates/strings",
      "scopes": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ]
    },
    "label": {
      "description": "Labels and goto targets",
      "scopes": [
        "entity.name.label"
      ]
    },
    "preprocessor": {
      "description": "Preprocessor directives (#include, #define, etc.)",
      "scopes": [
        "meta.preprocessor",
        "entity.name.function.preprocessor",
