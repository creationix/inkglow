    "variable": {
      "description": "Local variable references",
      "scopes": [
        "variable",
        "variable.other",
        "meta.definition.variable.name",
        "entity.name.variable"
      ]
    },
    "variable.constant": {
      "description": "Constants and enum members",
      "scopes": [
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ]
    },
    "parameter": {
      "description": "Function/method parameter names",
