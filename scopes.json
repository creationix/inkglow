{
  "$comment": "Scope registry — lists every TextMate scope and semantic token that themes in this extension target. Used by build.mjs to generate VSCode theme files, and as a cross-reference for language grammar authors to ensure their scopes get highlighted.",

  "tokenRoles": {
    "comment": {
      "description": "Code comments — line, block, and doc comments",
      "scopes": [
        "comment",
        "comment.line",
        "comment.line.double-slash",
        "comment.line.number-sign",
        "comment.line.semicolon",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment",
        "string.comment"
      ]
    },
    "keyword": {
      "description": "Declaration/storage keywords (let, const, var, fn, struct, type, etc.)",
      "scopes": [
        "keyword",
        "storage.type",
        "storage",
        "storage.modifier"
      ]
    },
    "keyword.control": {
      "description": "Control flow keywords (if, else, for, while, return, break, continue, match)",
      "scopes": [
        "keyword.control",
        "keyword.control.loop",
        "keyword.control.conditional",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.trycatch",
        "keyword.control.exception"
      ]
    },
    "operator": {
      "description": "Operators — arithmetic, logical, comparison, assignment, bitwise",
      "scopes": [
        "keyword.operator",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.wordlike"
      ]
    },
    "string": {
      "description": "String literals — single-quoted, double-quoted, template, multiline",
      "scopes": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.other",
        "string.quoted.triple",
        "string.template",
        "meta.embedded.assembly"
      ]
    },
    "string.regexp": {
      "description": "Regular expression literals",
      "scopes": [
        "string.regexp",
        "source.regexp",
        "constant.regexp",
        "string.regexp.character-class",
        "string.regexp.arbitrary-repitition"
      ]
    },
    "escape": {
      "description": "Escape sequences inside strings (\\n, \\t, \\x00, etc.)",
      "scopes": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ]
    },
    "interpolation": {
      "description": "String interpolation/template expression delimiters",
      "scopes": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end"
      ]
    },
    "number": {
      "description": "Numeric literals — decimal, float, hex, binary, octal",
      "scopes": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal",
        "constant.numeric.dozenal",
        "keyword.other.unit"
      ]
    },
    "constant": {
      "description": "Language constants — null, undefined, nil, none, etc.",
      "scopes": [
        "constant.language",
        "variable.language"
      ]
    },
    "boolean": {
      "description": "Boolean literals — true, false",
      "scopes": [
        "constant.language.boolean"
      ]
    },
    "type": {
      "description": "Built-in/primitive type names",
      "scopes": [
        "entity.name.type",
        "support.type.builtin",
        "support.type.primitive"
      ]
    },
    "type.user": {
      "description": "User-defined type names — classes, interfaces, structs, enums",
      "scopes": [
        "support.type",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.module",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class"
      ]
    },
    "type.nominal": {
      "description": "Nominal/newtype wrappers — distinct types with same representation",
      "scopes": [
        "support.type.nominal"
      ]
    },
    "type.comptime": {
      "description": "Compile-time / type-level computation types",
      "scopes": [
        "support.type.comptime"
      ]
    },
    "typeParameter": {
      "description": "Generic type parameters (T, U, etc.)",
      "scopes": [
        "entity.name.type.parameter",
        "support.type.parameter"
