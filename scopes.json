        "variable.parameter",
        "variable.parameter.function"
      ]
    },
    "parameter.output": {
      "description": "Output/out/inout parameter names",
      "scopes": [
        "variable.parameter.output"
      ]
    },
    "variable.global": {
      "description": "Global/module-level variable references",
      "scopes": [
        "variable.other.global"
      ]
    },
    "property": {
      "description": "Object/struct property and field names",
      "scopes": [
