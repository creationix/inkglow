{
  "name": "inkglow",
  "displayName": "Inkglow Themes",
  "description": "Color themes for VS Code — gel-pen darks, earthy lights, and curated retro palettes",
  "version": "0.1.0",
  "publisher": "creationix",
  "license": "MIT",
  "repository": "https://github.com/creationix/inkglow",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./scopes.json": "./scopes.json",
    "./inkglow.json": "./inkglow.json",
    "./inkglow-quill.json": "./inkglow-quill.json",
    "./inkglow-storm.json": "./inkglow-storm.json",
    "./inkglow-charm.json": "./inkglow-charm.json",
    "./inkglow-frost.json": "./inkglow-frost.json",
    "./inkglow-blaze.json": "./inkglow-blaze.json",
    "./inkglow-hearth.json": "./inkglow-hearth.json",
    "./inkglow-dusk.json": "./inkglow-dusk.json",
    "./inkglow-gilt.json": "./inkglow-gilt.json"
  },
  "files": [
    "index.mjs",
    "scopes.json",
    "inkglow.json",
    "inkglow-quill.json",
    "inkglow-storm.json",
    "inkglow-charm.json",
    "inkglow-frost.json",
    "inkglow-blaze.json",
    "inkglow-hearth.json",
    "inkglow-dusk.json",
    "inkglow-gilt.json",
    "themes/",
    "colors/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "report-256": "node build.mjs --report-256",
    "preview": "node preview.mjs",
    "preview:compact": "node preview.mjs --compact",
    "preview:palette": "node preview.mjs --palette",
    "screenshots": "node screenshots.mjs --readme",
    "vscode:prepublish": "node build.mjs"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Inkglow",
        "uiTheme": "vs-dark",
        "path": "./themes/inkglow.json"
      },
      {
        "label": "Inkglow Quill",
        "uiTheme": "vs",
        "path": "./themes/inkglow-quill.json"
      },
      {
        "label": "Inkglow Storm",
        "uiTheme": "vs",
        "path": "./themes/inkglow-storm.json"
      },
      {
        "label": "Inkglow Charm",
        "uiTheme": "vs-dark",
        "path": "./themes/inkglow-charm.json"
      },
      {
        "label": "Inkglow Frost",
        "uiTheme": "vs",
        "path": "./themes/inkglow-frost.json"
      },
      {
        "label": "Inkglow Blaze",
        "uiTheme": "vs-dark",
        "path": "./themes/inkglow-blaze.json"
      },
      {
        "label": "Inkglow Hearth",
        "uiTheme": "vs",
        "path": "./themes/inkglow-hearth.json"
      },
      {
        "label": "Inkglow Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/inkglow-dusk.json"
      },
      {
        "label": "Inkglow Gilt",
        "uiTheme": "vs",
        "path": "./themes/inkglow-gilt.json"
      }
    ]
  }
}
